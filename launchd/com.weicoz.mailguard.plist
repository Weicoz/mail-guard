<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.weicoz.mailguard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/goimapnotify</string>
        <string>-conf</string>
        <string>/Users/weicoz/.config/goimapnotify/goimapnotify.yaml</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/weicoz/.config/mail-guard/mailguard.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/weicoz/.config/mail-guard/mailguard.err</string>
</dict>
</plist>
