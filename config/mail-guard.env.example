# ==============================================================================
# mail-guard 环境变量与大模型/Harness 调度配置模板
# ==============================================================================
# mail-guard 原生支持两种大模型驱动方式：
# 1. 免 Key 模式 (Harness Mode): 零配置 API Key，直接调用本机已登录的 AI Coding Harness CLI
#    - 支持原生探查与调用: claude (Claude Code), codex (OpenAI Codex), kimi (Kimi Code),
#      agy (Antigravity), dsh (DeepSeek Harness), cline, zcode, kiro, kilo
# 2. REST API 模式 (API Mode): 兼容 OpenAI 规范的 API (如 DeepSeek, 通义千问, OpenAI, OneAPI, Ollama 本地模型)
# 3. 自动模式 (auto): 优先使用 API Key (若配置)；若无 Key，自动无缝切换为本机可用 Harness；
#    若两者均未安装或执行异常，自动平滑回退至本地规则引擎 (0-Token、0-Crash)。

# 大模型调度驱动模式: "auto" (默认推荐), "api" (仅REST API), "harness" (仅本机Harness)
LLM_PROVIDER="auto"

# ------------------------------------------------------------------------------
# 选项 A: 本机 Coding Harness 调度配置 (免 API Key)
# ------------------------------------------------------------------------------
# 目标 Harness: "auto" (自动按 claude -> codex -> kimi -> agy -> dsh 优先级探测可用项)
# 也可明确指定: "claude", "codex", "kimi", "agy", "dsh", "cline", "zcode", "kiro", "kilo", "custom"
LLM_HARNESS="auto"

# 自定义 Harness 执行命令模板 (可选，配合 LLM_HARNESS="custom" 或用于扩展任意 CLI)
# 支持 {prompt} 占位符；若未写 {prompt}，系统会自动将提示词通过 stdin 管道传入
# 示例:
#   LLM_HARNESS_CMD="cline-cli run -p {prompt}"
#   LLM_HARNESS_CMD="zcode run --prompt {prompt}"
LLM_HARNESS_CMD=""

# Harness 单次调用超时时限 (秒，默认 60 秒)
LLM_HARNESS_TIMEOUT="60"

# ------------------------------------------------------------------------------
# 选项 B: REST API 模式配置 (若使用 Harness 或 Ollama 可留空)
# ------------------------------------------------------------------------------
# 大模型 API Key (留空时自动使用本机 Harness 或本地规则)
LLM_API_KEY=""

# 大模型服务接口地址 (默认兼容 OpenAI 规范及代理)
# 示例:
# DeepSeek: https://api.deepseek.com/v1
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# Ollama 本地: http://localhost:11434/v1
LLM_BASE_URL="https://api.openai.com/v1"

# 使用的模型名称 (示例: gpt-4o-mini, deepseek-chat, qwen-plus)
LLM_MODEL="gpt-4o-mini"

# ==============================================================================
# 通知推送配置 (可选，按需开启；优先接入本机 harness-notify 统一推送)
# ==============================================================================
# 飞书用户 open_id (配合本机 lark-cli 直推本人，留空则跳过)
FEISHU_USER=""

# iOS Bark 推送密钥 (打开 Bark App 获取，留空则跳过)
BARK_KEY=""
BARK_SERVER="https://api.day.app"

# ==============================================================================
# 定时汇总排班配置 (可选，留空则使用默认 6 班制)
# ==============================================================================
# 每日定时汇总时刻表 (英文逗号分隔的时间点，默认约 3 小时 6 班制，00:30~08:30 深夜免打扰)
# 支持任意自定义时间组合，修改后运行 `mail-guard daemon schedule --apply` 或 `mail-guard daemon restart` 即刻生效
# 示例:
#   SUMMARY_SCHEDULE="08:30, 12:00, 15:30, 18:30, 21:30, 00:30" (推荐默认)
#   SUMMARY_SCHEDULE="08:00, 10:00, 12:00, 14:00, 16:00, 18:00, 20:00, 22:00" (每2小时)
#   SUMMARY_SCHEDULE="09:00, 13:00, 18:00, 22:00" (经典4班制)
SUMMARY_SCHEDULE="08:30, 12:00, 15:30, 18:30, 21:30, 00:30"
